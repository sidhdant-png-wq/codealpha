#include <iostream>
#include <fstream>
#include <vector>
#include <string>
#include <iomanip>
#include <ctime>
#include <limits>
using namespace std;

class BankAccount
{
public:
    long long accountNumber;
    string name;
    string phone;
    string accountType;
    double balance;

    BankAccount()
    {
        accountNumber = 0;
        balance = 0;
    }
};

class BankManagement
{
private:
    vector<BankAccount> accounts;

    const string accountFile = "accounts.txt";
    const string transactionFile = "transactions.txt";

    long long nextAccountNumber = 1001;

    // Find Account
    int findAccount(long long accNo)
    {
        for (int i = 0; i < accounts.size(); i++)
        {
            if (accounts[i].accountNumber == accNo)
                return i;
        }

        return -1;
    }

    // Save Accounts
    void saveAccounts()
    {
        ofstream file(accountFile);

        for (auto acc : accounts)
        {
            file << acc.accountNumber << "|"
                 << acc.name << "|"
                 << acc.phone << "|"
                 << acc.accountType << "|"
                 << acc.balance << endl;
        }

        file.close();
    }

    // Load Accounts
    void loadAccounts()
    {
        ifstream file(accountFile);

        if (!file)
            return;

        string line;

        while (getline(file, line))
        {
            BankAccount acc;

            size_t p1 = line.find('|');
            size_t p2 = line.find('|', p1 + 1);
            size_t p3 = line.find('|', p2 + 1);
            size_t p4 = line.find('|', p3 + 1);

            if (p1 == string::npos || p2 == string::npos ||
                p3 == string::npos || p4 == string::npos)
                continue;

            try
            {
                acc.accountNumber = stoll(line.substr(0, p1));
                acc.name = line.substr(p1 + 1, p2 - p1 - 1);
                acc.phone = line.substr(p2 + 1, p3 - p2 - 1);
                acc.accountType = line.substr(p3 + 1, p4 - p3 - 1);
                acc.balance = stod(line.substr(p4 + 1));

                accounts.push_back(acc);

                if (acc.accountNumber >= nextAccountNumber)
                    nextAccountNumber = acc.accountNumber + 1;
            }
            catch (...)
            {
                continue;
            }
        }

        file.close();
    }

    // Transaction History
    void recordTransaction(long long accNo, string type, double amount)
    {
        ofstream file(transactionFile, ios::app);

        time_t now = time(0);
        string date = ctime(&now);

        if (!date.empty() && date.back() == '\n')
            date.pop_back();

        file << "Account: " << accNo
             << " | Type: " << type
             << " | Amount: " << fixed << setprecision(2) << amount
             << " | Date: " << date << endl;

        file.close();
    }

    // Input validation
    void clearInput()
    {
        cin.clear();
        cin.ignore(numeric_limits<streamsize>::max(), '\n');
    }

    // Account Details
    void displayAccount(int index)
    {
        BankAccount acc = accounts[index];

        cout << "\n========== ACCOUNT DETAILS ==========\n";

        cout << "Account Number : " << acc.accountNumber << endl;
        cout << "Account Holder : " << acc.name << endl;
        cout << "Phone Number   : " << acc.phone << endl;
        cout << "Account Type   : " << acc.accountType << endl;
        cout << "Balance        : Rs. "
             << fixed << setprecision(2) << acc.balance << endl;

        cout << "=====================================\n";
    }

public:

    BankManagement()
    {
        loadAccounts();
    }

    // Create Account
    void createAccount()
    {
        BankAccount acc;

        cout << "\n========== CREATE NEW ACCOUNT ==========\n";

        acc.accountNumber = nextAccountNumber++;

        cout << "Enter Account Holder Name: ";
        getline(cin >> ws, acc.name);

        cout << "Enter Phone Number: ";
        getline(cin, acc.phone);

        cout << "\nSelect Account Type:\n";
        cout << "1. Savings Account\n";
        cout << "2. Current Account\n";
        cout << "Enter Choice: ";

        int choice;
        cin >> choice;

        if (choice == 1)
            acc.accountType = "Savings";
        else if (choice == 2)
            acc.accountType = "Current";
        else
        {
            cout << "Invalid Account Type!\n";
            nextAccountNumber--;
            return;
        }

        cout << "Enter Initial Deposit: Rs. ";
        cin >> acc.balance;

        if (cin.fail() || acc.balance < 0)
        {
            cout << "Invalid deposit amount!\n";
            clearInput();
            nextAccountNumber--;
            return;
        }

        accounts.push_back(acc);

        saveAccounts();

        cout << "\nAccount Created Successfully!\n";
        cout << "Your Account Number: " << acc.accountNumber << endl;

        recordTransaction(acc.accountNumber, "Account Opening", acc.balance);
    }

    // Deposit Money
    void depositMoney()
    {
        long long accNo;
        double amount;

        cout << "\nEnter Account Number: ";
        cin >> accNo;

        int index = findAccount(accNo);

        if (index == -1)
        {
            cout << "Account Not Found!\n";
            return;
        }

        cout << "Enter Deposit Amount: Rs. ";
        cin >> amount;

        if (cin.fail() || amount <= 0)
        {
            cout << "Invalid Amount!\n";
            clearInput();
            return;
        }

        accounts[index].balance += amount;

        saveAccounts();

        recordTransaction(accNo, "Deposit", amount);

        cout << "\nMoney Deposited Successfully!\n";
        cout << "Updated Balance: Rs. "
             << accounts[index].balance << endl;
    }

    // Withdraw Money
    void withdrawMoney()
    {
        long long accNo;
        double amount;

        cout << "\nEnter Account Number: ";
        cin >> accNo;

        int index = findAccount(accNo);

        if (index == -1)
        {
            cout << "Account Not Found!\n";
            return;
        }

        cout << "Enter Withdrawal Amount: Rs. ";
        cin >> amount;

        if (cin.fail() || amount <= 0)
        {
            cout << "Invalid Amount!\n";
            clearInput();
            return;
        }

        if (amount > accounts[index].balance)
        {
            cout << "\nInsufficient Balance!\n";
            return;
        }

        accounts[index].balance -= amount;

        saveAccounts();

        recordTransaction(accNo, "Withdrawal", amount);

        cout << "\nWithdrawal Successful!\n";
        cout << "Remaining Balance: Rs. "
             << accounts[index].balance << endl;
    }

    // Check Balance
    void checkBalance()
    {
        long long accNo;

        cout << "\nEnter Account Number: ";
        cin >> accNo;

        int index = findAccount(accNo);

        if (index == -1)
        {
            cout << "Account Not Found!\n";
            return;
        }

        cout << "\nAvailable Balance: Rs. "
             << fixed << setprecision(2)
             << accounts[index].balance << endl;
    }

    // Search Account
    void searchAccount()
    {
        long long accNo;

        cout << "\nEnter Account Number: ";
        cin >> accNo;

        int index = findAccount(accNo);

        if (index == -1)
        {
            cout << "Account Not Found!\n";
            return;
        }

        displayAccount(index);
    }

    // Transfer Money
    void transferMoney()
    {
        long long sender, receiver;
        double amount;

        cout << "\nEnter Sender Account Number: ";
        cin >> sender;

        int senderIndex = findAccount(sender);

        if (senderIndex == -1)
        {
            cout << "Sender Account Not Found!\n";
            return;
        }

        cout << "Enter Receiver Account Number: ";
        cin >> receiver;

        int receiverIndex = findAccount(receiver);

        if (receiverIndex == -1 || sender == receiver)
        {
            cout << "Invalid Receiver Account!\n";
            return;
        }

        cout << "Enter Transfer Amount: Rs. ";
        cin >> amount;

        if (cin.fail() || amount <= 0)
        {
            cout << "Invalid Amount!\n";
            clearInput();
            return;
        }

        if (accounts[senderIndex].balance < amount)
        {
            cout << "Insufficient Balance!\n";
            return;
        }

        accounts[senderIndex].balance -= amount;
        accounts[receiverIndex].balance += amount;

        saveAccounts();

        recordTransaction(sender, "Transfer Sent", amount);
        recordTransaction(receiver, "Transfer Received", amount);

        cout << "\nMoney Transferred Successfully!\n";
    }

    // Transaction History
    void transactionHistory()
    {
        long long accNo;

        cout << "\nEnter Account Number: ";
        cin >> accNo;

        if (findAccount(accNo) == -1)
        {
            cout << "Account Not Found!\n";
            return;
        }

        ifstream file(transactionFile);

        if (!file)
        {
            cout << "No Transaction History Available!\n";
            return;
        }

        string line;
        bool found = false;

        cout << "\n========== TRANSACTION HISTORY ==========\n";

        while (getline(file, line))
        {
            string search = "Account: " + to_string(accNo);

            if (line.find(search) != string::npos)
            {
                cout << line << endl;
                found = true;
            }
        }

        if (!found)
            cout << "No Transactions Found!\n";

        file.close();
    }

    // Update Account Details
    void updateAccount()
    {
        long long accNo;

        cout << "\nEnter Account Number: ";
        cin >> accNo;

        int index = findAccount(accNo);

        if (index == -1)
        {
            cout << "Account Not Found!\n";
            return;
        }

        cout << "Enter New Name: ";
        getline(cin >> ws, accounts[index].name);

        cout << "Enter New Phone Number: ";
        getline(cin, accounts[index].phone);

        saveAccounts();

        cout << "\nAccount Details Updated Successfully!\n";
    }

    // Delete Account
    void deleteAccount()
    {
        long long accNo;

        cout << "\nEnter Account Number: ";
        cin >> accNo;

        int index = findAccount(accNo);

        if (index == -1)
        {
            cout << "Account Not Found!\n";
            return;
        }

        if (accounts[index].balance != 0)
        {
            cout << "Please withdraw or transfer the remaining balance first.\n";
            return;
        }

        accounts.erase(accounts.begin() + index);

        saveAccounts();

        cout << "\nAccount Deleted Successfully!\n";
    }

    // Display All Accounts
    void displayAllAccounts()
    {
        if (accounts.empty())
        {
            cout << "\nNo Accounts Available!\n";
            return;
        }

        cout << "\n========== ALL BANK ACCOUNTS ==========\n";

        cout << left
             << setw(15) << "Account No."
             << setw(20) << "Name"
             << setw(15) << "Type"
             << setw(15) << "Balance"
             << endl;

        cout << string(65, '-') << endl;

        for (auto acc : accounts)
        {
            cout << left
                 << setw(15) << acc.accountNumber
                 << setw(20) << acc.name
                 << setw(15) << acc.accountType
                 << fixed << setprecision(2)
                 << setw(15) << acc.balance
                 << endl;
        }
    }

    // Main Menu
    void menu()
    {
        int choice;

        do
        {
            cout << "\n";
            cout << "============================================\n";
            cout << "          BANK MANAGEMENT SYSTEM\n";
            cout << "============================================\n";

            cout << "1.  Create New Account\n";
            cout << "2.  Deposit Money\n";
            cout << "3.  Withdraw Money\n";
            cout << "4.  Check Balance\n";
            cout << "5.  Search Account Details\n";
            cout << "6.  Transfer Money\n";
            cout << "7.  Transaction History\n";
            cout << "8.  Update Account Details\n";
            cout << "9.  Delete Account\n";
            cout << "10. Display All Accounts\n";
            cout << "11. Exit\n";

            cout << "--------------------------------------------\n";
            cout << "Enter Your Choice: ";

            cin >> choice;

            if (cin.fail())
            {
                cout << "Invalid Input! Enter a number.\n";
                clearInput();
                continue;
            }

            switch (choice)
            {
                case 1:
                    createAccount();
                    break;

                case 2:
                    depositMoney();
                    break;

                case 3:
                    withdrawMoney();
                    break;

                case 4:
                    checkBalance();
                    break;

                case 5:
                    searchAccount();
                    break;

                case 6:
                    transferMoney();
                    break;

                case 7:
                    transactionHistory();
                    break;

                case 8:
                    updateAccount();
                    break;

                case 9:
                    deleteAccount();
                    break;

                case 10:
                    displayAllAccounts();
                    break;

                case 11:
                    cout << "\nThank You For Using Our Banking System!\n";
                    break;

                default:
                    cout << "\nInvalid Choice! Please Try Again.\n";
            }

        } while (choice != 11);
    }
};

// Main Function
int main()
{
    BankManagement bank;

    cout << "\n";
    cout << "********************************************\n";
    cout << "       WELCOME TO BANK MANAGEMENT\n";
    cout << "********************************************\n";

    bank.menu();

    return 0;
}
